{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pt",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pt/vsl",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/vsl",
      "permanent": true
    },
    {
      "source": "/pt/presell",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/pt"
    },
    {
      "source": "/vsl",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/pt/vsl"
    },
    {
      "source": "/presell",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "destination": "/pt"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
