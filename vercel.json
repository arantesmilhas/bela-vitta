{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "dest": "/pt"
    },
    {
      "src": "^/vsl/?$",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "dest": "/pt/vsl"
    },
    {
      "src": "^/presell/?$",
      "has": [
        {
          "type": "host",
          "value": "naturallvitttamais.astroluz.site"
        }
      ],
      "dest": "/pt"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
